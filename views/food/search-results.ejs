<!doctype html><html lang="en"><head><%- include("../partials/head") %><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title><style>
:root{--ink:#28231f;--muted:#786f65;--line:#eee4d8;--orange:#f36b35;--green:#286b4b}body{background:#fffaf5;color:var(--ink)}.food-wrap{max-width:1160px;margin:25px auto 70px;padding:20px}.food-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.food-top h1{font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.05em;margin:0}.food-search{display:flex;gap:9px;margin:22px 0 28px;background:#fff;padding:8px;border:1px solid var(--line);border-radius:15px}.food-search input{flex:1;min-width:0;border:0;padding:10px;outline:0;font:inherit}.food-search button,.action{border:0;background:var(--green);color:white;padding:11px 17px;border-radius:999px;font-weight:800;text-decoration:none;cursor:pointer}.food-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.food-card{background:#fff;border:1px solid var(--line);border-radius:19px;overflow:hidden}.food-card img{width:100%;height:210px;object-fit:cover;background:#eee}.food-card-body{padding:16px}.food-card h2{font-size:1.1rem;margin:0 0 7px}.food-card p{color:var(--muted);font-size:.9rem;line-height:1.5;min-height:42px}.price{font-size:1.1rem;font-weight:850;margin:10px 0 14px}.food-card .action{display:inline-block}.empty{padding:35px;text-align:center;border:1px dashed var(--line);border-radius:16px}@media(max-width:800px){.food-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.food-grid{grid-template-columns:1fr}.food-card img{height:230px}}
</style></head><body><%- include("../partials/nave") %><main class="food-wrap"><div class="food-top"><div><h1>Find your food</h1><p><%=search ? 'Search results for “'+search+'”' : 'Explore the Goan Craving menu' %></p></div><a href="/cart" class="action">Cart (<%=cartCount%>)</a></div><form class="food-search" action="/search" method="GET"><input name="q" value="<%=search%>" placeholder="Search Chicken Cafreal, Fish Curry..." aria-label="Search food" autofocus><button type="submit">Search</button></form><% if(!products.length){ %><div class="empty"><h2>No matching food found</h2><p>Try another dish name or browse the menu.</p></div><% }else{ %><div class="food-grid"><% products.forEach(product=>{ %><article class="food-card"><a href="/products/<%=product._id%>"><img src="<%=product.imageURL||'/imgs/default.png'%>" alt="<%=product.name%>" loading="lazy" onerror="this.onerror=null;this.src='/imgs/default.png'"></a><div class="food-card-body"><h2><a href="/products/<%=product._id%>" style="color:inherit;text-decoration:none"><%=product.name%></a></h2><p><%=product.description%></p><div class="price">₹<%=Number(product.price).toFixed(2)%></div><a class="action" href="/products/<%=product._id%>">View details</a></div></article><% }) %></div><% } %></main><%- include("../partials/scripts") %></body></html>
