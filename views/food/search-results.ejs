<!doctype html>
<html lang="en"><head><%- include("../partials/head") %><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title>
<style>
:root{--ink:#28231f;--muted:#786f65;--line:#eee4d8;--orange:#f36b35;--green:#286b4b;--soft:#fffaf5}
*{box-sizing:border-box}body{background:var(--soft);color:var(--ink)}.food-wrap{max-width:1160px;margin:95px auto 70px;padding:20px}.food-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.food-top h1{font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.05em;margin:0}.food-top p{color:var(--muted);margin:7px 0 0}.action{border:0;background:var(--green);color:white;padding:11px 17px;border-radius:999px;font-weight:800;text-decoration:none;cursor:pointer;white-space:nowrap}.search-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;margin:22px 0 15px;background:#fff;padding:8px;border:1px solid var(--line);border-radius:15px}.search-form input{width:100%;min-width:0;border:0;padding:10px;outline:0;font:inherit}.search-form button{border:0;background:var(--green);color:white;padding:11px 18px;border-radius:999px;font-weight:800;cursor:pointer}.filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;background:#fff;border:1px solid var(--line);border-radius:17px;padding:16px;margin-bottom:18px}.filter-field label{display:block;font-size:.78rem;font-weight:800;margin-bottom:6px}.filter-field select,.filter-field input{width:100%;min-width:0;border:1px solid var(--line);border-radius:10px;padding:10px;background:#fff;color:var(--ink);font:inherit}.price-range{display:flex;gap:6px}.price-range input{width:50%;min-width:0}.filter-actions{display:flex;align-items:end;gap:8px}.filter-actions button,.reset{border:0;border-radius:10px;padding:11px 13px;font-weight:800;cursor:pointer;text-decoration:none;text-align:center}.filter-actions button{background:var(--orange);color:#fff}.reset{background:#f4eee7;color:#51483e}.results-bar{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:15px 0;color:var(--muted);font-size:.9rem}.results-bar strong{color:var(--ink)}.food-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.food-card{background:#fff;border:1px solid var(--line);border-radius:19px;overflow:hidden}.food-card img{width:100%;height:210px;object-fit:cover;background:#eee}.food-card-body{padding:16px}.food-card h2{font-size:1.1rem;margin:0 0 7px}.meta{font-size:.78rem;color:var(--green);font-weight:800}.food-card p{color:var(--muted);font-size:.9rem;line-height:1.5;min-height:42px}.price{font-size:1.1rem;font-weight:850;margin:10px 0 14px}.food-card .action{display:inline-block}.empty{padding:35px;text-align:center;border:1px dashed var(--line);border-radius:16px;background:#fff}.empty h2{margin-top:0}
@media(max-width:900px){.filters{grid-template-columns:repeat(3,minmax(0,1fr))}.food-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.food-wrap{margin-top:95px;padding:14px}.food-grid{grid-template-columns:1fr}.food-card img{height:230px}.filters{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px}.filter-actions{grid-column:1/-1}.filter-actions button,.filter-actions .reset{flex:1}.food-top{align-items:flex-start}.food-top h1{font-size:1.7rem}.search-form{grid-template-columns:1fr auto}.results-bar{align-items:flex-start;flex-direction:column}}
</style></head><body><%- include("../partials/nave") %>
<main class="food-wrap">
<header class="food-top"><div><h1>Find your food</h1><p><%=search ? 'Search results for “'+search+'”' : 'Explore restaurants and Goan favourites' %></p></div><a href="/cart" class="action">Cart (<%=cartCount%>)</a></header>
<form class="search-form" action="/search" method="GET"><input name="q" value="<%=search%>" placeholder="Search dish, restaurant or hotel name…" aria-label="Search food or restaurant"><button type="submit">Search</button></form>
<form class="filters" action="/search" method="GET" id="filterForm">
<input type="hidden" name="q" value="<%=search%>">
<div class="filter-field"><label for="restaurant">Restaurant / hotel</label><select id="restaurant" name="restaurant"><option value="">All listed restaurants</option><% restaurants.forEach(name=>{ %><option value="<%=name%>" <%=filters.restaurant===name?'selected':''%>><%=name%></option><% }) %></select></div>
<div class="filter-field"><label for="category">Food category</label><select id="category" name="category"><option value="">All categories</option><% categories.forEach(name=>{ %><option value="<%=name%>" <%=filters.category===name?'selected':''%>><%=name%></option><% }) %></select></div>
<div class="filter-field"><label>Price range (₹)</label><div class="price-range"><input type="number" name="minPrice" min="0" step="1" placeholder="Min" aria-label="Minimum price" value="<%=filters.minPrice%>"><input type="number" name="maxPrice" min="0" step="1" placeholder="Max" aria-label="Maximum price" value="<%=filters.maxPrice%>"></div></div>
<div class="filter-field"><label for="sort">Sort results</label><select id="sort" name="sort"><option value="name-asc" <%=filters.sort==='name-asc'?'selected':''%>>Name: A to Z</option><option value="name-desc" <%=filters.sort==='name-desc'?'selected':''%>>Name: Z to A</option><option value="price-asc" <%=filters.sort==='price-asc'?'selected':''%>>Price: Low to high</option><option value="price-desc" <%=filters.sort==='price-desc'?'selected':''%>>Price: High to low</option><option value="newest" <%=filters.sort==='newest'?'selected':''%>>Newest first</option></select></div>
<div class="filter-actions"><button type="submit"><i class="fa-solid fa-filter"></i> Apply filters</button><a class="reset" href="/search">Reset</a></div>
</form>
<div class="results-bar"><span><strong><%=products.length%></strong> food item<%=products.length===1?'':'s'%> found</span><span>Prices shown in Indian rupees</span></div>
<% if(!products.length){ %><div class="empty"><h2>No matching food found</h2><p>Try changing the restaurant, category or price range.</p><a class="action" href="/search">Clear all filters</a></div><% }else{ %><div class="food-grid"><% products.forEach(product=>{ %><article class="food-card"><a href="/products/<%=product._id%>"><img src="<%=product.imageURL||'/imgs/default.png'%>" alt="<%=product.name%>" loading="lazy" onerror="this.onerror=null;this.src='/imgs/default.png'"></a><div class="food-card-body"><div class="meta"><%=product.sellerName||product.category||'Goan Craving menu'%></div><h2><a href="/products/<%=product._id%>" style="color:inherit;text-decoration:none"><%=product.name%></a></h2><p><%=product.description%></p><div class="price">₹<%=Number(product.price).toFixed(2)%></div><a class="action" href="/products/<%=product._id%>">View details</a></div></article><% }) %></div><% } %>
</main><%- include("../partials/scripts") %></body></html>