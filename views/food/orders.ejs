<!doctype html><html lang="en"><head><%- include("../partials/head") %><title>My Orders | Goan Craving</title><style>body{background:#fffaf5}.orders{max-width:900px;margin:70px auto;padding:18px}.order{background:white;border:1px solid #eee4d8;border-radius:16px;padding:18px;margin:14px 0;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}.orders h1{color:#205b36}.muted{color:#766f66}.link{color:#e96e36;font-weight:800}</style></head><body><%- include("../partials/nave") %><main class="orders"><h1>My Orders</h1><% if(!orders.length){ %><div class="order"><p>You haven’t placed an order yet.</p><a class="link" href="/search">Explore food</a></div><% } %><% orders.forEach(o=>{ %><article class="order"><div><strong>Order #<%=String(o._id).slice(-8).toUpperCase()%></strong><p class="muted"><%=new Date(o.createdAt).toLocaleString()%> · <%=o.items.length%> item(s)</p><p><%=o.orderStatus.replace(/_/g," ")%> · ₹<%=Number(o.total).toFixed(2)%></p></div><a class="link" href="/orders/<%=o._id%>"><%=o.orderStatus==="delivered"?"View details & rate food →":"View details →"%></a></article><% }) %></main><%- include("../partials/scripts") %></body></html>