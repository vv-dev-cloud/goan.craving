<!doctype html><html lang="en"><head><%- include("../partials/head") %><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title><style>body{background:#fffaf5;color:#28231f}.checkout{max-width:680px;margin:60px auto;padding:28px;background:#fff;border:1px solid #eee4d8;border-radius:22px;text-align:center}.checkout h1{font-size:2rem}.checkout p{color:#786f65;line-height:1.6}.checkout a{display:inline-block;margin:8px;padding:12px 18px;border-radius:999px;background:#286b4b;color:white;text-decoration:none;font-weight:800}</style></head><body><%- include("../partials/nave") %><main class="checkout"><h1>Checkout is coming next</h1><p>Your cart is ready. Payment and order placement are not connected in this phase, so no payment will be taken.</p><p><strong>Cart total: ₹<%=total.toFixed(2)%></strong></p><a href="/cart">Back to cart</a><a href="/search">Continue shopping</a></main><%- include("../partials/scripts") %></body></html>