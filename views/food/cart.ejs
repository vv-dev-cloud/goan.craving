<!doctype html><html lang="en"><head><%- include("../partials/head") %><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title><style>
:root{--ink:#28231f;--muted:#786f65;--line:#eee4d8;--green:#286b4b;--orange:#f36b35}body{background:#fffaf5;color:var(--ink)}.cart{max-width:1000px;margin:102px auto 70px;padding:20px}.cart h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.05em}.cart-row{display:grid;grid-template-columns:100px 1fr auto;gap:17px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line)}.cart-row img{width:100px;height:85px;object-fit:cover;border-radius:14px}.cart-row h2{font-size:1.05rem;margin:0 0 6px}.muted{color:var(--muted)}.qty{width:70px;padding:8px;border:1px solid var(--line);border-radius:9px}.small-btn{border:0;border-radius:9px;padding:9px 12px;font-weight:800;cursor:pointer}.update{background:#e9f2ec;color:var(--green)}.remove{background:#fff0eb;color:#a63c1d}.summary{margin:24px 0 0 auto;max-width:350px;padding:20px;background:#fff;border:1px solid var(--line);border-radius:17px}.total{display:flex;justify-content:space-between;font-size:1.2rem;font-weight:900}.checkout{display:block;text-align:center;text-decoration:none;background:var(--orange);color:white;padding:13px;border-radius:999px;font-weight:850;margin-top:15px}.continue{color:var(--green);font-weight:800}.empty{text-align:center;padding:45px 20px;border:1px dashed var(--line);border-radius:18px}@media(max-width:600px){.cart-row{grid-template-columns:75px 1fr}.cart-row img{width:75px;height:75px}.cart-row .row-actions{grid-column:2}.summary{max-width:none}}
</style></head><body><%- include("../partials/nave") %><main class="cart"><h1>Your cart</h1><p class="muted">Review your food picks before checkout.</p><% if(!items.length){ %><div class="empty"><h2>Your cart is empty</h2><p>Find something delicious to add.</p><a class="continue" href="/search">Browse food →</a></div><% }else{ %><% items.forEach(item=>{const product=item.product;%><article class="cart-row"><img src="<%=product.imageURL||'/imgs/default.png'%>" alt="<%=product.name%>" onerror="this.onerror=null;this.src='/imgs/default.png'"><div><h2><%=product.name%></h2><div class="muted">₹<%=Number(product.price).toFixed(2)%> each</div><strong>Subtotal: ₹<%=(product.price*item.quantity).toFixed(2)%></strong></div><div class="row-actions"><form action="/cart/update" method="POST" style="display:flex;gap:6px;align-items:center;margin-bottom:8px"><input type="hidden" name="productId" value="<%=product._id%>"><input class="qty" type="number" name="quantity" value="<%=item.quantity%>" min="1" max="99" aria-label="Quantity for <%=product.name%>"><button class="small-btn update" type="submit">Update</button></form><form action="/cart/remove" method="POST"><input type="hidden" name="productId" value="<%=product._id%>"><button class="small-btn remove" type="submit">Remove</button></form></div></article><% }) %><div class="summary"><div class="total"><span>Cart total</span><span>₹<%=total.toFixed(2)%></span></div><p class="muted">Delivery fees and payment are calculated in the next checkout phase.</p><a class="checkout" href="/checkout">Proceed to Checkout</a></div><% } %><p><a class="continue" href="/search">← Continue shopping</a></p></main><%- include("../partials/scripts") %></body></html>
