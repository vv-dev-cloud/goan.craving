<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=title%></title>
  <style>
    :root{--ink:#28231f;--muted:#786f65;--line:#eee4d8;--orange:#f36b35;--green:#286b4b}body{background:#fffaf5;color:var(--ink)}.detail{max-width:1000px;margin:32px auto 40px;padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}.detail>div>img{width:100%;height:420px;object-fit:cover;border-radius:24px;background:#eee}.detail h1{font-size:clamp(2rem,5vw,3.3rem);letter-spacing:-.05em;line-height:1.04}.detail p{color:var(--muted);line-height:1.7}.price{font-size:1.6rem;font-weight:900;margin:20px 0}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions button{border:0;border-radius:999px;padding:13px 18px;font-weight:850;cursor:pointer}.add{background:var(--green);color:white}.buy{background:var(--orange);color:white}.qty{width:75px;padding:10px;border:1px solid var(--line);border-radius:10px;font:inherit}.back{color:var(--green);font-weight:800}.reviews{max-width:1000px;margin:0 auto 70px;padding:20px}.review{background:white;border:1px solid var(--line);border-radius:16px;padding:18px;margin:12px 0}.review-head{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.rating{color:#d99500;font-weight:900}.review-photos{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.review-photos img{width:110px;height:110px;object-fit:cover;border-radius:12px}.verified{color:var(--green);font-size:.82rem;font-weight:800}.empty{background:white;border:1px dashed var(--line);border-radius:16px;padding:24px;color:var(--muted)}@media(max-width:700px){.detail{grid-template-columns:1fr}.detail>div>img{height:280px}.reviews{padding:16px}}
  </style>
</head>
<body>
<%- include("../partials/nave") %>
<main>
  <section class="detail">
    <div><img src="<%=product.imageURL||'/imgs/default.png'%>" alt="<%=product.name%>" onerror="this.onerror=null;this.src='/imgs/default.png'"></div>
    <section><a class="back" href="/search">← Back to food search</a><p><%=product.category%></p><h1><%=product.name%></h1><p><%=product.description%></p><% if(product.ingredients&&product.ingredients.length){ %><p><strong>Ingredients:</strong> <%=product.ingredients.join(", ")%></p><% } %><div class="price">₹<%=Number(product.price).toFixed(2)%></div><% if(reviewCount){ %><p class="rating">★ <%=averageRating.toFixed(1)%>/5 · <%=reviewCount%> verified customer review<%=reviewCount===1?"":"s"%></p><% }else{ %><p class="muted">No customer reviews yet.</p><% } %><div class="actions"><form action="/cart/add" method="POST"><input type="hidden" name="productId" value="<%=product._id%>"><input class="qty" type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity"><button class="add" type="submit">Add to Cart</button></form><form action="/cart/add" method="POST"><input type="hidden" name="productId" value="<%=product._id%>"><input type="hidden" name="quantity" value="1"><input type="hidden" name="buyNow" value="1"><button class="buy" type="submit">Buy Now</button></form></div><p><a class="back" href="/cart">View cart (<%=cartCount%>)</a></p></section>
  </section>
  <section class="reviews"><h2>Customer reviews</h2><p class="muted">Reviews from customers whose orders were successfully delivered.</p>
    <% if(!reviews.length){ %><div class="empty">Be the first to share your experience after ordering this food.</div><% } %>
    <% reviews.forEach(review=>{ %><article class="review"><div class="review-head"><strong><%=review.author?.fullName||"Goan Craving customer"%></strong><span class="rating"><%= "★".repeat(review.rating||0) %><%= "☆".repeat(5-(review.rating||0)) %> <%=review.rating%>/5</span></div><p class="verified">✓ Verified order</p><% if(review.content&&review.content!=="Rated this food."){ %><p><%=review.content%></p><% } %><% if(review.images&&review.images.length){ %><div class="review-photos"><% review.images.forEach(src=>{ %><img src="<%=src%>" alt="Customer food photo" loading="lazy"><% }) %></div><% } %><p class="muted"><%=new Date(review.createdAt).toLocaleDateString("en-IN")%></p></article><% }) %>
  </section>
</main>
<%- include("../partials/scripts") %>
</body>
</html>
