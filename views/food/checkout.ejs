<!doctype html><html lang="en"><head><%- include("../partials/head") %><title>Checkout | Goan Craving</title><style>
body{background:#fffaf5;color:#26352a}.checkout{max-width:1000px;margin:35px auto 70px;padding:18px;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,1fr);gap:22px}.panel{background:white;border:1px solid #eee4d8;border-radius:18px;padding:22px}.panel h1,.panel h2{color:#205b36;margin-top:0}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fields input{width:100%;padding:13px;border:1px solid #e5ded3;border-radius:10px;font:inherit}.wide{grid-column:1/-1}.pay{display:block;border:1px solid #e9e4dc;padding:13px;border-radius:12px;margin:10px 0}.pay input{margin-right:8px}.submit{background:#ef7138;color:white;border:0;border-radius:12px;padding:14px 18px;font-weight:800;width:100%;cursor:pointer}.line{display:flex;justify-content:space-between;gap:12px;margin:12px 0}.error{background:#fff0ed;color:#a53b27;padding:12px;border-radius:10px}@media(max-width:700px){.checkout{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.wide{grid-column:auto}}
</style></head><body><%- include("../partials/nave") %><main class="checkout"><section class="panel"><h1>Delivery & payment</h1><p>Enter where you’d like your food delivered.</p><% if(error){ %><p class="error"><%=error%></p><% } %><form method="post" action="/checkout"><div class="fields"><input name="fullName" placeholder="Full name" required value="<%=user.fullName||''%>"><input name="phone" placeholder="Phone number" required><input class="wide" name="addressLine" placeholder="House / street address" required><input name="area" placeholder="Area / locality" required><input name="city" placeholder="City / village" required><input name="state" placeholder="State" required value="Goa"><input name="postalCode" placeholder="PIN code" inputmode="numeric" required></div><h2 style="margin-top:25px">Payment option</h2><label class="pay"><input type="radio" name="paymentMethod" value="cod" required checked> Cash on Delivery</label><label class="pay"><input type="radio" name="paymentMethod" value="upi" required> UPI <small>(online payment setup required)</small></label><label class="pay"><input type="radio" name="paymentMethod" value="card" required> Credit / debit card <small>(online payment setup required)</small></label><button class="submit" type="submit">Place order · ₹<%=Number(total).toFixed(2)%></button></form></section><aside class="panel"><h2>Order summary</h2><% items.forEach(i=>{ %><div class="line"><span><%=i.product.name%> × <%=i.quantity%></span><strong>₹<%=Number(i.product.price*i.quantity).toFixed(2)%></strong></div><% }) %><hr><div class="line"><strong>Total</strong><strong>₹<%=Number(total).toFixed(2)%></strong></div></aside></main><%- include("../partials/scripts") %></body></html>