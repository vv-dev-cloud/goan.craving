<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Checkout | Goan Craving</title>
  <style>
    :root{--green:#185b3b;--green2:#28734d;--orange:#ed7138;--cream:#fff9f2;--line:#eee5da;--muted:#766f65}
    *{box-sizing:border-box}body{background:var(--cream);color:#292d27}.checkout-wrap{max-width:1120px;margin:88px auto 64px;padding:18px}.checkout-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}.checkout-head h1{margin:0;color:var(--green);font-size:clamp(1.7rem,4vw,2.35rem)}.checkout-head a{color:var(--green);font-weight:800;text-decoration:none}.checkout-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:20px;align-items:start}.panel{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 12px 32px #34271908;margin-bottom:16px}.panel h2{font-size:1.15rem;color:var(--green);margin:0 0 15px}.step{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#eaf3ec;color:var(--green);font-weight:900;margin-right:8px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;font-size:.78rem;font-weight:800;color:#625d54;margin:0 0 6px}.field input,.field textarea{width:100%;border:1px solid #e4ddd3;border-radius:11px;padding:12px;background:#fff;font:inherit;min-width:0}.field.wide{grid-column:1/-1}.address-note{padding:12px 14px;background:#f2f7f1;border-radius:12px;color:#315b3e;font-size:.86rem;margin-bottom:15px}.error{padding:12px;background:#fff0ed;color:#a33e2c;border-radius:11px;margin:0 0 14px}.payment-option{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:13px;padding:13px;margin:9px 0}.payment-option input{accent-color:var(--green)}.payment-option strong{display:block}.payment-option small{display:block;color:var(--muted);margin-top:3px}.payment-option.disabled{opacity:.55;background:#faf9f7}.method-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:#f2f5ef;color:var(--green);font-weight:900}.secure-note{font-size:.78rem;color:var(--muted);line-height:1.5}.food-line{display:grid;grid-template-columns:58px 1fr auto;gap:11px;align-items:center;padding:10px 0;border-bottom:1px solid #f1ece5}.food-line img{width:58px;height:58px;border-radius:11px;object-fit:cover}.food-line strong{font-size:.9rem}.food-line small{display:block;color:var(--muted);margin-top:3px}.amount-line{display:flex;justify-content:space-between;gap:12px;margin:12px 0;font-size:.9rem}.amount-line.total{font-size:1.2rem;font-weight:900;color:var(--green);padding-top:13px;border-top:1px solid var(--line)}.coupon{display:flex;gap:8px;margin:14px 0}.coupon input{flex:1;min-width:0;border:1px solid var(--line);border-radius:10px;padding:11px;font:inherit}.coupon button{border:0;border-radius:10px;padding:0 13px;background:#f1eee8;color:#7d766d;font-weight:800}.place-order{width:100%;border:0;border-radius:13px;padding:15px;background:var(--green);color:#fff;font-weight:900;font-size:1rem;cursor:pointer}.empty-address{background:#fff8e9;border:1px solid #f1dfb8;border-radius:12px;padding:12px;font-size:.85rem;color:#775d2d;margin-bottom:14px}
    @media(max-width:760px){.checkout-grid{grid-template-columns:1fr}.checkout-wrap{margin-top:78px;padding:13px}.panel{padding:17px}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.checkout-head{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
<%- include("../partials/nave") %>
<main class="checkout-wrap">
  <header class="checkout-head"><div><h1>Complete your order</h1><p style="color:var(--muted);margin:6px 0 0">Fresh Goan food, delivered to your door.</p></div><a href="/cart">← Back to cart</a></header>
  <div class="checkout-grid">
    <section class="panel">
      <h2><span class="step">1</span>Delivery address</h2>
      <% if(!defaultAddress){ %><div class="empty-address">You haven't saved a delivery address yet. Add your address below to continue.</div><% } else { %><div class="address-note">Your saved address is pre-filled. You can update it for this order.</div><% } %>
      <% if(error){ %><p class="error"><%=error%></p><% } %>
      <form id="checkoutForm" method="post" action="/checkout">
        <input type="hidden" name="buyNowId" value="<%=typeof buyNowId!=='undefined'?buyNowId:''%>">
        <div class="fields">
          <div class="field"><label for="fullName">Full name *</label><input id="fullName" name="fullName" autocomplete="name" maxlength="100" required placeholder="Your full name" value="<%=defaultAddress?.fullName||user.fullName||''%>"></div>
          <div class="field"><label for="phone">Mobile number *</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="18" required placeholder="Mobile number" value="<%=defaultAddress?.phone||''%>"></div>
          <div class="field wide"><label for="addressLine">House / street address *</label><input id="addressLine" name="addressLine" autocomplete="street-address" maxlength="180" required placeholder="House number, street" value="<%=defaultAddress?.addressLine||''%>"></div>
          <div class="field"><label for="area">Area / locality *</label><input id="area" name="area" maxlength="120" required placeholder="Area or locality" value="<%=defaultAddress?.area||''%>"></div>
          <div class="field"><label for="city">Village / city *</label><input id="city" name="city" maxlength="80" required placeholder="Village or city" value="<%=defaultAddress?.city||''%>"></div>
          <div class="field"><label for="state">State *</label><input id="state" name="state" maxlength="80" required value="<%=defaultAddress?.state||'Goa'%>"></div>
          <div class="field"><label for="postalCode">PIN code *</label><input id="postalCode" name="postalCode" inputmode="numeric" pattern="[0-9]{5,10}" maxlength="10" required placeholder="PIN code" value="<%=defaultAddress?.postalCode||''%>"></div>
          <div class="field wide"><label for="instructions">Delivery instructions (optional)</label><textarea id="instructions" name="instructions" rows="2" maxlength="250" placeholder="Landmark, gate or delivery note"><%=defaultAddress?.instructions||''%></textarea></div>
        </div>
        <h2 style="margin-top:24px"><span class="step">2</span>Payment method</h2>
        <label class="payment-option"><span class="method-icon">₹</span><span style="flex:1"><strong>Cash on Delivery</strong><small>Pay the delivery agent when your order arrives</small></span><input type="radio" name="paymentMethod" value="cod" checked required></label>
        <div class="payment-option disabled"><span class="method-icon">UPI</span><span style="flex:1"><strong>UPI · PhonePe · Google Pay · Paytm</strong><small>Online payments will be enabled after payment gateway setup</small></span><input type="radio" disabled aria-label="UPI currently unavailable"></div>
        <div class="payment-option disabled"><span class="method-icon">▣</span><span style="flex:1"><strong>Credit / Debit Card</strong><small>Secure card checkout will be enabled after gateway setup</small></span><input type="radio" disabled aria-label="Card payments currently unavailable"></div>
        <div class="payment-option disabled"><span class="method-icon">🏦</span><span style="flex:1"><strong>Net Banking</strong><small>Coming with online payment integration</small></span><input type="radio" disabled aria-label="Net banking currently unavailable"></div>
        <p class="secure-note">Your address is saved to your Goan Craving account for faster future checkout. Never share your UPI PIN, card PIN or OTP with anyone.</p>
        <button class="place-order" type="submit">Place order · ₹<%=Number(total).toFixed(2)%></button>
      </form>
    </section>
    <aside class="panel">
      <h2><span class="step">3</span>Order summary</h2>
      <% items.forEach(i=>{ %><div class="food-line"><img src="<%=i.product.imageURL||'/imgs/default.png'%>" alt="<%=i.product.name%>" onerror="this.src='/imgs/default.png'"><span><strong><%=i.product.name%></strong><small>Qty <%=i.quantity%> × ₹<%=Number(i.product.price).toFixed(2)%></small></span><strong>₹<%=Number(i.product.price*i.quantity).toFixed(2)%></strong></div><% }) %>
      <div class="coupon"><input type="text" disabled placeholder="Coupon codes coming soon" aria-label="Coupon code"><button type="button" disabled>Apply</button></div>
      <div class="amount-line"><span>Item subtotal</span><strong>₹<%=Number(total).toFixed(2)%></strong></div>
      <div class="amount-line"><span>Discount</span><strong>₹0.00</strong></div>
      <div class="amount-line"><span>GST / taxes</span><span>Not configured</span></div>
      <div class="amount-line"><span>Delivery fee</span><span>Not configured</span></div>
      <div class="amount-line total"><span>Payable amount*</span><span>₹<%=Number(total).toFixed(2)%></span></div>
      <p class="secure-note">*Currently this amount is the food subtotal only. GST, delivery charges and coupon discounts are not added until their rules are configured; no fees are guessed.</p>
    </aside>
  </div>
</main>
<%- include("../partials/scripts") %>
</body>
</html>