<!doctype html><html lang="en"><head><%- include("../partials/head") %><title>Order details | Goan Craving</title><style>body{background:#fffaf5}.detail{max-width:780px;margin:70px auto;padding:18px}.panel{background:white;border:1px solid #eee4d8;border-radius:18px;padding:22px;margin:14px 0}.detail h1,.detail h2{color:#205b36}.row{display:flex;justify-content:space-between;gap:15px;margin:12px 0}.muted{color:#786f65}</style></head><body><%- include("../partials/nave") %><main class="detail"><h1>Order placed</h1><p class="muted">Reference #<%=String(order._id).slice(-8).toUpperCase()%> · <%=new Date(order.createdAt).toLocaleString()%></p><section class="panel"><h2>Items</h2><% order.items.forEach(i=>{ %><div class="row"><span><%=i.name%> × <%=i.quantity%></span><strong>₹<%=Number(i.unitPrice*i.quantity).toFixed(2)%></strong></div><% }) %><hr><div class="row"><strong>Total</strong><strong>₹<%=Number(order.total).toFixed(2)%></strong></div></section><section class="panel"><h2>Delivery address</h2><p><%=order.deliveryAddress.fullName%><br><%=order.deliveryAddress.phone%><br><%=order.deliveryAddress.addressLine%>, <%=order.deliveryAddress.area%><br><%=order.deliveryAddress.city%>, <%=order.deliveryAddress.state%> - <%=order.deliveryAddress.postalCode%></p></section><section class="panel"><h2>Payment & status</h2><p><%=({cod:"Cash on Delivery",upi:"UPI",card:"Credit / debit card"})[order.paymentMethod]%> · <%=order.paymentStatus%></p><p>Order status: <strong><%=order.orderStatus.replace(/_/g," ")%></strong></p><a href="/orders">← My Orders</a></section></main><%- include("../partials/scripts") %></body></html>