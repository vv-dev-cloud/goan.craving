<!doctype html>
<html lang="en">
<head>
  <%- include("../partials/head") %>
  <title>Order details | Goan Craving</title>
  <style>
    body{background:#fffaf5;color:#29251f}.detail{max-width:820px;margin:76px auto;padding:18px}.panel{background:#fff;border:1px solid #eee4d8;border-radius:18px;padding:22px;margin:14px 0}.detail h1,.detail h2{color:#205b36}.muted{color:#786f65}.item{display:grid;grid-template-columns:76px 1fr;gap:14px;padding:14px 0;border-bottom:1px solid #f0e9e1}.item:last-child{border-bottom:0}.item img.thumb{width:76px;height:76px;object-fit:cover;border-radius:12px}.review-box{background:#fffaf5;border:1px solid #f0e1d3;border-radius:14px;padding:16px;margin-top:14px}.stars{display:flex;flex-direction:row-reverse;justify-content:flex-end;gap:5px}.stars input{position:absolute;opacity:0}.stars label{font-size:28px;color:#d7d1c8;cursor:pointer}.stars input:checked~label,.stars label:hover,.stars label:hover~label{color:#f2a900}.review-box textarea{width:100%;min-height:95px;border:1px solid #e5ddd3;border-radius:10px;padding:12px;font:inherit;box-sizing:border-box}.review-box input[type=file]{max-width:100%;margin:10px 0}.submit{border:0;border-radius:10px;background:#205b36;color:white;padding:12px 18px;font-weight:800;cursor:pointer}.photos{display:flex;gap:8px;flex-wrap:wrap}.photos img{width:88px;height:88px;object-fit:cover;border-radius:10px}.notice{padding:12px 14px;border-radius:10px;background:#edf7ed;color:#205b36;margin:12px 0}.review-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.delete{color:#b23b31;background:none;border:0;text-decoration:underline;cursor:pointer}@media(max-width:600px){.detail{margin-top:64px;padding:12px}.panel{padding:16px}}
  </style>
</head>
<body>
<%- include("../partials/nave") %>
<main class="detail">
  <h1>Order details</h1>
  <p class="muted">Order #<%=(order.orderNumber || ("GC-" + String(order._id).slice(-8).toUpperCase()))%> · <%=new Date(order.createdAt).toLocaleString("en-IN")%></p>
  <% if(reviewMessage==="success"){ %><div class="notice">Your food review has been saved. Thank you for sharing your experience!</div><% } else if(reviewMessage==="already-submitted"){ %><div class="notice">Your review is already recorded. You can edit it below.</div><% } %>
  <section class="panel">
    <h2>Ordered food</h2>
    <% order.items.forEach(item=>{ const productId=String(item.product||""); const review=reviewsByProduct[productId]; %>
      <article class="item">
        <img class="thumb" src="<%=item.imageURL||'/imgs/default.png'%>" alt="<%=item.name%>" onerror="this.onerror=null;this.src='/imgs/default.png'">
        <div>
          <strong><%=item.name%></strong>
          <p class="muted"><%=item.quantity%> × ₹<%=Number(item.unitPrice).toFixed(2)%></p>
          <% if(order.orderStatus==="delivered"){ %>
            <div class="review-box">
              <h3><%=review?"Your review":"Rate this food"%></h3>
              <% if(review){ %>
                <p><strong><%=review.rating%>/5 ★</strong> · <span class="muted">Verified order</span></p>
                <% if(review.content&&review.content!=="Rated this food."){ %><p><%=review.content%></p><% } %>
                <% if(review.images&&review.images.length){ %><div class="photos"><% review.images.forEach(src=>{ %><img src="<%=src%>" alt="Customer food review photo" loading="lazy"><% }) %></div><% } %>
                <div class="review-actions"><span class="muted">You can update your rating or description below.</span><form method="POST" action="/food-reviews/<%=review._id%>/delete" onsubmit="return confirm('Delete this review?')"><button class="delete" type="submit">Delete review</button></form></div>
              <% } %>
              <form method="POST" enctype="multipart/form-data" action="/food-reviews/orders/<%=order._id%>/products/<%=productId%>">
                <div class="stars" role="radiogroup" aria-label="Food rating">
                  <% for(let n=1;n<=5;n++){ %><input id="rating-<%=productId%>-<%=n%>" type="radio" name="rating" value="<%=n%>" <%=Number(review?.rating||0)===n?"checked":""%> required><label for="rating-<%=productId%>-<%=n%>" title="<%=n%> stars">★</label><% } %>
                </div>
                <label for="description-<%=productId%>"><strong>Describe your experience</strong></label>
                <textarea id="description-<%=productId%>" name="description" maxlength="1200" placeholder="How was the taste, quality and portion size?"><%=review&&review.content!=="Rated this food."?review.content:""%></textarea>
                <label for="foodImages-<%=productId%>"><strong>Add food photos</strong> <span class="muted">(up to 5, optional)</span></label><br>
                <input id="foodImages-<%=productId%>" type="file" name="foodImages" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
                <p class="muted">Uploading new photos replaces the photos currently attached to this review. Maximum 10 MB per photo.</p>
                <button class="submit" type="submit"><%=review?"Update review":"Submit review"%></button>
              </form>
            </div>
          <% } else { %>
            <p class="muted">You can rate this food after the order is marked as delivered.</p>
          <% } %>
        </div>
      </article>
    <% }) %>
    <div class="item"><strong>Total</strong><strong>₹<%=Number(order.total).toFixed(2)%></strong></div>
  </section>
  <section class="panel"><h2>Delivery address</h2><p><%=order.deliveryAddress.fullName%><br><%=order.deliveryAddress.phone%><br><%=order.deliveryAddress.addressLine%>, <%=order.deliveryAddress.area%><br><%=order.deliveryAddress.city%>, <%=order.deliveryAddress.state%> - <%=order.deliveryAddress.postalCode%></p></section>
  <section class="panel"><h2>Payment &amp; status</h2><p><%=({cod:"Cash on Delivery",upi:"UPI",card:"Credit / debit card"})[order.paymentMethod]%> · <%=order.paymentStatus%></p><p>Order status: <strong><%=order.orderStatus.replace(/_/g," ")%></strong></p><a href="/orders">← My Orders</a></section>
</main>
<%- include("../partials/scripts") %>
</body>
</html>
