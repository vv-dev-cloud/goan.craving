<!doctype html>
<html lang="en"><head><%- include("./partials/head") %><meta name="viewport" content="width=device-width,initial-scale=1"><title>Edit Profile | Goan Craving</title>
<style>
:root{--green:#174d35;--green2:#286b4b;--orange:#e9783e;--cream:#fbf7ef;--line:#eee6da;--muted:#7c756b}
body{background:var(--cream);color:#27352b}.edit-wrap{max-width:760px;margin:70px auto 60px;padding:0 16px}.edit-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.edit-head h1{font-size:1.65rem;font-weight:900;color:var(--green);margin:0}.back{color:var(--green);font-weight:800;text-decoration:none}.panel{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px;box-shadow:0 12px 32px #3528170a}.avatar-box{display:grid;place-items:center;margin:4px auto 22px}.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;border:4px solid #eaf2eb}.photo-btn{margin-top:10px;color:var(--green);font-weight:800;cursor:pointer}.hint{color:var(--muted);font-size:.82rem;text-align:center;margin-top:5px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field.wide{grid-column:1/-1}.field label{display:block;font-size:.82rem;font-weight:800;margin-bottom:6px}.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:12px;background:#fff;color:#27352b;font:inherit}.field input:focus,.field textarea:focus{outline:2px solid #d8e9dc;border-color:var(--green2)}.readonly{background:#f7f4ef!important;color:#8b8379!important}.actions{display:flex;justify-content:flex-end;gap:9px;margin-top:20px}.btn{border:0;border-radius:11px;padding:12px 17px;font-weight:850;text-decoration:none;cursor:pointer}.primary{background:var(--green);color:#fff}.secondary{background:#f4eee5;color:#4c463e}.status{min-height:22px;margin-top:12px;font-size:.85rem;color:var(--green);text-align:right}
@media(max-width:600px){.edit-wrap{margin-top:70px}.panel{padding:18px}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.edit-head h1{font-size:1.35rem}.actions{flex-direction:column-reverse}.actions .btn{width:100%;text-align:center}}
</style></head><body><%- include("./partials/nave") %>
<main class="edit-wrap"><header class="edit-head"><h1><i class="fa-solid fa-user-pen"></i> Edit profile</h1><a class="back" href="/account"><i class="fa-solid fa-arrow-left"></i> Account</a></header>
<section class="panel"><div class="avatar-box"><img class="avatar" id="preview" src="<%= user.profileImageURL || '/imgs/default.png' %>" alt="Profile photo" onerror="this.src='/imgs/default.png'"><label class="photo-btn" for="imageInput"><i class="fa-solid fa-camera"></i> Change photo</label><input id="imageInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden><div class="hint">Use a clear photo so your delivery account is easy to recognise.</div></div>
<form id="profileForm"><div class="fields">
<div class="field wide"><label for="fullName">Full name</label><input id="fullName" name="fullName" maxlength="100" required value="<%= user.fullName || '' %>" autocomplete="name"></div>
<div class="field wide"><label for="email">Email address</label><input id="email" class="readonly" value="<%= user.email || '' %>" readonly><small class="hint" style="text-align:left">Email is managed by your sign-in provider.</small></div>
<div class="field wide"><label for="location">Default area / locality (optional)</label><input id="location" name="location" maxlength="120" value="<%= user.location || '' %>" placeholder="e.g. Sanguem, Goa" autocomplete="address-level2"><small class="hint" style="text-align:left">Your saved delivery addresses are managed separately in Account.</small></div>
</div><div class="actions"><a class="btn secondary" href="/account">Cancel</a><button class="btn primary" id="saveBtn" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save changes</button></div><div class="status" id="status" role="status" aria-live="polite"></div></form></section></main>
<%- include("./partials/scripts") %><script>
const statusEl=document.getElementById('status'),imageInput=document.getElementById('imageInput'),preview=document.getElementById('preview');
imageInput.addEventListener('change',async()=>{const file=imageInput.files?.[0];if(!file)return;if(!['image/jpeg','image/png','image/webp','image/gif'].includes(file.type)||file.size>10*1024*1024){statusEl.textContent='Choose a JPG, PNG, WEBP or GIF image up to 10MB.';imageInput.value='';return}const old=preview.src;preview.src=URL.createObjectURL(file);statusEl.textContent='Uploading photo…';const fd=new FormData();fd.append('profileImage',file);try{const r=await fetch('/user/profile/upload-image',{method:'POST',body:fd,credentials:'same-origin',headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Photo upload failed');preview.src=d.imageURL;statusEl.textContent='Profile photo updated.'}catch(e){preview.src=old;statusEl.textContent=e.message}finally{imageInput.value=''}});
document.getElementById('profileForm').addEventListener('submit',async e=>{e.preventDefault();const btn=document.getElementById('saveBtn');btn.disabled=true;btn.textContent='Saving…';const body={fullName:document.getElementById('fullName').value,location:document.getElementById('location').value};try{const r=await fetch('/user/profile/update',{method:'PUT',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to save profile');statusEl.textContent='Profile saved successfully.';setTimeout(()=>location.href='/account',650)}catch(err){statusEl.textContent=err.message;btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-floppy-disk"></i> Save changes'}});
</script></body></html>