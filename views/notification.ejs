<!doctype html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Notifications | Goan Craving</title>
  <style>
    :root{--ink:#25231f;--muted:#81776c;--line:#eee3d5;--cream:#fff8ef;--orange:#f36b35;--green:#286b4b}
    *{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
    .notify-page{max-width:1000px;margin:0 auto;padding:94px 22px 55px}.notify-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:22px}.notify-kicker{color:var(--green);font-size:.72rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.notify-head h1{font-size:clamp(2rem,5vw,3rem);letter-spacing:-.065em;margin:7px 0}.notify-head p{margin:0;color:var(--muted);line-height:1.5}.notify-actions{display:flex;gap:9px;flex-wrap:wrap}.notify-btn{border:1px solid var(--line);background:#fff;border-radius:999px;padding:11px 15px;font-weight:800;color:var(--ink);cursor:pointer}.notify-btn.primary{background:var(--green);border-color:var(--green);color:#fff}.notify-hero{display:flex;align-items:center;gap:16px;padding:18px 20px;border-radius:20px;background:linear-gradient(110deg,#e8f2e9,#fff2df);border:1px solid #dce9dc;margin-bottom:22px}.notify-hero-icon{width:48px;height:48px;flex:0 0 48px;display:grid;place-items:center;border-radius:15px;background:#fff;color:var(--green);font-size:1.35rem}.notify-hero-copy{flex:1;min-width:0}.notify-hero-copy strong{display:block;margin-bottom:4px}.notify-hero-copy span{display:block;color:#6f7166;font-size:.82rem;line-height:1.5}.notify-tabs{display:flex;gap:8px;overflow:auto;padding:2px 0 14px;scrollbar-width:none}.notify-tabs::-webkit-scrollbar{display:none}.notify-tab{flex:0 0 auto;border:1px solid var(--line);background:#fff;color:#756c61;border-radius:999px;padding:9px 15px;font-size:.8rem;font-weight:800;cursor:pointer}.notify-tab.active{background:var(--orange);border-color:var(--orange);color:#fff}.notify-list{display:grid;gap:10px}.notify-card{display:flex;gap:14px;align-items:flex-start;padding:16px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 6px 22px #50331d08}.notify-card.unread{border-color:#efb38e;background:#fffdf9}.notify-icon{width:44px;height:44px;flex:0 0 44px;border-radius:14px;display:grid;place-items:center;background:#f1f5e9;font-size:1.2rem}.notify-content{flex:1;min-width:0}.notify-title{font-weight:850;color:#28251f;margin:1px 0 5px}.notify-message{color:#6f685f;font-size:.88rem;line-height:1.55;overflow-wrap:anywhere}.notify-meta{display:flex;align-items:center;gap:8px;margin-top:8px;color:#958a7d;font-size:.72rem}.notify-dot{width:7px;height:7px;border-radius:50%;background:var(--orange)}.notify-card-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.notify-link,.notify-read{display:inline-flex;align-items:center;border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 11px;color:var(--green);font-size:.76rem;font-weight:850;text-decoration:none;cursor:pointer}.notify-empty{text-align:center;padding:55px 18px;border:1px dashed #dfd1c0;border-radius:20px;background:#fff}.notify-empty .emoji{font-size:2.2rem}.notify-empty h3{margin:10px 0 5px}.notify-empty p{margin:0;color:var(--muted);font-size:.85rem}.notify-status{min-height:22px;color:var(--green);font-size:.8rem;margin-top:10px}
    @media(max-width:650px){.notify-page{padding:86px 13px 40px}.notify-head{display:block}.notify-actions{margin-top:14px}.notify-hero{align-items:flex-start;padding:15px}.notify-card{padding:13px;gap:10px}.notify-icon{width:39px;height:39px;flex-basis:39px}.notify-title{font-size:.9rem}.notify-message{font-size:.82rem}}
  </style>
</head>
<body>
<%- include('./partials/nave') %>
<main class="notify-page">
  <% const list=notifications||[]; const unread=list.filter(n=>!n.isRead).length; %>
  <header class="notify-head"><div><div class="notify-kicker">Your Goan Craving updates</div><h1>Notifications <span id="unreadTotal" style="font-size:.45em;vertical-align:middle;color:#f36b35"><%=unread?'('+unread+' new)':''%></span></h1><p>Order progress, payments and important account updates in one place.</p></div><div class="notify-actions"><button class="notify-btn" type="button" onclick="markAllRead()">✓ Mark all read</button><button class="notify-btn primary" type="button" onclick="enableWebPush()">♧ Enable push alerts</button></div></header>
  <section class="notify-hero"><div class="notify-hero-icon">🔔</div><div class="notify-hero-copy"><strong>Never miss an order update</strong><span>Turn on browser notifications to receive important updates even when Goan Craving is not open. You choose whether to enable them.</span></div></section>
  <nav class="notify-tabs" aria-label="Filter notifications"><button class="notify-tab active" data-filter="all" onclick="filterNotifications('all',this)">All</button><button class="notify-tab" data-filter="orders" onclick="filterNotifications('orders',this)">Orders</button><button class="notify-tab" data-filter="payment" onclick="filterNotifications('payment',this)">Payments & refunds</button><button class="notify-tab" data-filter="community" onclick="filterNotifications('community',this)">Community</button></nav>
  <section class="notify-list" id="notificationList">
  <% if(list.length){ list.forEach(n=>{ const foodTypes=['order_placed','order_status','payment','refund']; const isFood=foodTypes.includes(n.type); const group=n.type==='payment'||n.type==='refund'?'payment':isFood?'orders':'community'; const icons={order_placed:'🛵',order_status:'📦',payment:'💳',refund:'↩️',message:'💬',comment:'💭',reply:'↪️',like:'❤️',follow:'👋',follow_request:'👤',blog_post:'🍽️',mention:'🔔'}; const title=n.title||({order_placed:'Order received',order_status:'Order update',payment:'Payment update',refund:'Refund update'}[n.type]||'Goan Craving update'); %>
    <article class="notify-card <%=n.isRead?'':'unread'%>" data-group="<%=group%>" data-id="<%=n._id%>"><div class="notify-icon"><%=icons[n.type]||'🔔'%></div><div class="notify-content"><div class="notify-title"><%=title%></div><div class="notify-message"><%=n.message||'You have a new update.'%></div><div class="notify-meta"><span><%=new Date(n.createdAt).toLocaleString('en-IN',{dateStyle:'medium',timeStyle:'short'})%></span><% if(!n.isRead){ %><span class="notify-dot" aria-label="Unread"></span><span>New</span><% } %></div><div class="notify-card-actions"><% if(n.order){ %><a class="notify-link" href="/orders/<%=n.order._id||n.order%>" onclick="markRead('<%=n._id%>')">View order →</a><% }else if(n.blog){ %><a class="notify-link" href="/blogs/<%=n.blog._id||n.blog%>" onclick="markRead('<%=n._id%>')">View update →</a><% }else if(n.actor){ %><a class="notify-link" href="/profile/<%=n.actor._id%>" onclick="markRead('<%=n._id%>')">View profile →</a><% } %><% if(!n.isRead){ %><button class="notify-read" type="button" onclick="markRead('<%=n._id%>')">Mark read</button><% } %></div></div></article>
  <% }) }else{ %><div class="notify-empty"><div class="emoji">🌴</div><h3>You're all caught up</h3><p>When your order moves forward or something important happens, it will show up here.</p></div><% } %>
  </section><div class="notify-status" id="notifyStatus" role="status" aria-live="polite"></div>
</main>
<%- include('./partials/scripts') %>
<script>
async function markRead(id){try{const r=await fetch('/notifications/'+encodeURIComponent(id)+'/read',{method:'PUT',credentials:'same-origin',headers:{Accept:'application/json'}});if(!r.ok)throw new Error();const card=document.querySelector('[data-id="'+CSS.escape(id)+'"]');if(card){card.classList.remove('unread');card.querySelector('.notify-read')?.remove();card.querySelector('.notify-dot')?.remove();}document.getElementById('notifyStatus').textContent='Notification marked as read.';updateUnread();}catch(e){document.getElementById('notifyStatus').textContent='Could not update this notification. Please try again.';}}
async function markAllRead(){try{const r=await fetch('/notifications/all/read',{method:'PUT',credentials:'same-origin',headers:{Accept:'application/json'}});if(!r.ok)throw new Error();document.querySelectorAll('.notify-card.unread').forEach(card=>{card.classList.remove('unread');card.querySelector('.notify-read')?.remove();card.querySelector('.notify-dot')?.remove()});document.getElementById('notifyStatus').textContent='All notifications marked as read.';updateUnread();}catch(e){document.getElementById('notifyStatus').textContent='Unable to mark notifications as read.';}}
function updateUnread(){const count=document.querySelectorAll('.notify-card.unread').length;document.getElementById('unreadTotal').textContent=count?'('+count+' new)':'';}
function filterNotifications(group,button){document.querySelectorAll('.notify-tab').forEach(x=>x.classList.toggle('active',x===button));document.querySelectorAll('.notify-card').forEach(card=>card.hidden=group!=='all'&&card.dataset.group!==group);}
async function enableWebPush(){const status=document.getElementById('notifyStatus');const button=document.querySelector('.notify-btn.primary');if(!window.BlogifyPush){status.textContent='Push notifications are not supported in this browser.';return;}button.disabled=true;button.textContent='Enabling…';try{const ok=await window.BlogifyPush.enable();if(!ok)throw new Error(window.BlogifyPush.permission()==='denied'?'Notifications are blocked in your browser settings.':'Push notifications could not be enabled.');status.textContent='Push alerts are enabled on this device.';button.textContent='✓ Push enabled';}catch(e){status.textContent=e.message;button.textContent='Enable push alerts';}finally{button.disabled=false;}}
</script>
</body></html>