<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("./partials/head") %>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="description" content="Goan Craving brings the flavours of Goa to your doorstep. Discover local favourites and delicious meals.">
  <meta name="theme-color" content="#fff8ef">
  <title>Goan Craving — A taste of Goa, delivered</title>
  <style>
    :root{--gc-ink:#25231f;--gc-muted:#756e65;--gc-orange:#f36b35;--gc-green:#286b4b;--gc-cream:#fff8ef;--gc-line:#eee4d8}
    *{box-sizing:border-box}body{margin:0;background:#fff;color:var(--gc-ink);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit}
    .gc-shell{overflow:hidden}.gc-nav{max-width:1200px;margin:auto;padding:20px 28px;display:flex;align-items:center;gap:24px}.gc-brand{font-size:1.45rem;font-weight:900;letter-spacing:-.06em;text-decoration:none;white-space:nowrap}.gc-brand span{color:var(--gc-orange)}.gc-search{flex:1;max-width:540px;margin:0 auto;display:flex;align-items:center;gap:10px;border:1px solid var(--gc-line);background:#fffaf5;border-radius:999px;padding:12px 17px;color:#8b8176}.gc-search input{border:0;outline:0;background:transparent;width:100%;font:inherit;color:var(--gc-ink);font-size:.9rem}.gc-nav-actions{display:flex;align-items:center;gap:10px}.gc-nav-actions a{font-size:.88rem;font-weight:750;text-decoration:none;border-radius:999px;padding:12px 17px}.gc-login{border:1px solid var(--gc-line)}.gc-order{background:var(--gc-orange);color:#fff}
    .gc-hero{background:var(--gc-cream);position:relative}.gc-hero-inner{max-width:1200px;margin:auto;padding:66px 28px 70px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:44px}.gc-kicker{display:inline-flex;align-items:center;gap:8px;color:var(--gc-green);font-size:.76rem;font-weight:850;text-transform:uppercase;letter-spacing:.13em}.gc-kicker:before{content:"";width:24px;height:2px;background:var(--gc-green)}.gc-hero h1{font-size:clamp(3rem,6.6vw,5.8rem);line-height:.98;letter-spacing:-.075em;margin:19px 0 22px;max-width:640px}.gc-hero h1 em{font-style:normal;color:var(--gc-orange)}.gc-hero-copy{font-size:1.08rem;line-height:1.7;color:var(--gc-muted);max-width:500px}.gc-hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:27px}.gc-hero-ctas a{padding:15px 22px;border-radius:999px;text-decoration:none;font-weight:800;font-size:.9rem}.gc-primary{background:var(--gc-orange);color:#fff}.gc-secondary{border:1px solid #e4d8c9;background:#fff}.gc-note{margin-top:20px;color:#938779;font-size:.8rem}
    .gc-hero-art{position:relative;min-height:400px;display:grid;place-items:center}.gc-art-halo{position:absolute;width:min(100%,440px);aspect-ratio:1;border-radius:50%;background:#f7dfc7}.gc-food-main{position:relative;width:min(100%,450px);height:390px;object-fit:cover;border-radius:46% 46% 24px 24px;box-shadow:0 25px 65px #70421d22;transform:rotate(2deg)}.gc-float{position:absolute;z-index:2;background:#fff;border-radius:17px;padding:14px 17px;box-shadow:0 12px 35px #50331d1c;font-size:.82rem;font-weight:800}.gc-float small{display:block;color:var(--gc-muted);font-weight:600;margin-top:4px}.gc-float-one{left:-3px;bottom:45px}.gc-float-two{right:-2px;top:40px}
    .gc-section{max-width:1200px;margin:auto;padding:60px 28px}.gc-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:25px}.gc-section h2{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.06em;margin:0}.gc-section-head p{margin:8px 0 0;color:var(--gc-muted);line-height:1.6}.gc-category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.gc-category{border:1px solid var(--gc-line);border-radius:20px;padding:12px;background:#fff;text-align:center}.gc-category img{width:100%;height:165px;object-fit:cover;border-radius:14px;display:block}.gc-category h3{font-size:1rem;margin:13px 0 5px}.gc-category p{font-size:.8rem;color:var(--gc-muted);margin:0 0 8px}.gc-promo{max-width:1144px;margin:0 auto 60px;padding:30px 34px;border-radius:25px;background:#286b4b;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:25px}.gc-promo h2{font-size:clamp(1.5rem,3vw,2.3rem);letter-spacing:-.05em;margin:0 0 8px}.gc-promo p{margin:0;color:#d9e9df;line-height:1.6}.gc-promo a{background:#fff;color:var(--gc-green);padding:13px 20px;border-radius:999px;text-decoration:none;font-weight:850;white-space:nowrap}.gc-footer{border-top:1px solid var(--gc-line);padding:22px 28px;max-width:1200px;margin:auto;display:flex;justify-content:space-between;gap:15px;color:#8d8277;font-size:.78rem}
    @media(max-width:800px){.gc-nav{flex-wrap:wrap;padding:17px 20px;gap:13px}.gc-search{order:3;flex-basis:100%;max-width:none}.gc-hero-inner{grid-template-columns:1fr;padding:50px 22px 35px;gap:15px}.gc-hero-art{min-height:360px}.gc-food-main{height:340px;width:min(90%,420px)}.gc-category-grid{grid-template-columns:repeat(2,1fr)}.gc-promo{margin:0 20px 45px;flex-direction:column;align-items:flex-start}.gc-section{padding:48px 20px}.gc-section-head{display:block}.gc-section-head p{max-width:550px}}
    @media(max-width:480px){.gc-brand{font-size:1.25rem}.gc-nav-actions a{padding:10px 12px;font-size:.78rem}.gc-hero h1{font-size:clamp(2.8rem,13vw,4.1rem)}.gc-hero-copy{font-size:1rem}.gc-hero-art{min-height:320px}.gc-food-main{height:300px}.gc-float{font-size:.72rem;padding:11px 13px}.gc-float-one{left:0;bottom:22px}.gc-float-two{right:0;top:22px}.gc-category img{height:130px}.gc-promo{padding:25px}.gc-footer{padding:20px;flex-wrap:wrap}}
  </style>
</head>
<body>
<div class="gc-shell">
  <header class="gc-nav">
    <a class="gc-brand" href="/" aria-label="Goan Craving home">goan<span>.</span>craving</a>
    <form class="gc-search" role="search" action="/" method="get">
      <span aria-hidden="true">⌕</span>
      <input type="search" name="search" placeholder="Search dishes, restaurants, or cravings..." aria-label="Search dishes and restaurants">
      <span aria-hidden="true">⌘</span>
    </form>
    <nav class="gc-nav-actions" aria-label="Account">
      <a class="gc-login" href="/user/signin">Sign in</a>
      <a class="gc-order" href="/user/signup">Get started ↗</a>
    </nav>
  </header>
  <main>
    <section class="gc-hero">
      <div class="gc-hero-inner">
        <div>
          <div class="gc-kicker">A little taste of Goa</div>
          <h1>Your Goan cravings,<br><em>delivered.</em></h1>
          <p class="gc-hero-copy">From comforting local favourites to fresh coastal flavours, discover food that feels like home. Your next delicious moment starts here.</p>
          <div class="gc-hero-ctas"><a class="gc-primary" href="/user/signup">Explore food <span aria-hidden="true">↗</span></a><a class="gc-secondary" href="/user/signin">Sign in to continue</a></div>
          <p class="gc-note">Local flavour. Freshly made. Made for your cravings.</p>
        </div>
        <div class="gc-hero-art" aria-label="Goan food">
          <div class="gc-art-halo"></div>
          <img class="gc-food-main" src="https://images.unsplash.com/photo-1547592120-4b6f2b5c6b7c?auto=format&fit=crop&w=1000&q=85" alt="A delicious meal served fresh" loading="eager">
          <div class="gc-float gc-float-one">🌶️ Goan flavour<small>Big taste, local soul</small></div>
          <div class="gc-float gc-float-two">🍽️ Made with care<small>Good food, good mood</small></div>
        </div>
      </div>
    </section>
    <section class="gc-section">
      <div class="gc-section-head"><div><h2>What are you craving?</h2><p>Find a favourite for every kind of appetite.</p></div></div>
      <div class="gc-category-grid">
        <article class="gc-category"><img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=700&q=80" alt="Pizza" loading="lazy"><h3>Quick bites</h3><p>Something delicious, fast</p></article>
        <article class="gc-category"><img src="https://images.unsplash.com/photo-156 used?auto=format&fit=crop&w=700&q=80" alt="Aromatic curry" loading="lazy"><h3>Goan classics</h3><p>Local favourites to love</p></article>
        <article class="gc-category"><img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=700&q=80" alt="Grilled food" loading="lazy"><h3>Grill & seafood</h3><p>Fresh coastal cravings</p></article>
        <article class="gc-category"><img src="https://images.unsplash.com/photo-1551024506-0ccccd828d8b?auto=format&fit=crop&w=700&q=80" alt="Sweet dessert" loading="lazy"><h3>Sweet treats</h3><p>Save room for dessert</p></article>
      </div>
    </section>
    <section class="gc-promo">
      <div><h2>Good food brings us together.</h2><p>Sign in or create an account to start your Goan Craving journey.</p></div>
      <a href="/user/signup">Join Goan Craving ↗</a>
    </section>
  </main>
  <footer class="gc-footer"><span>© <%= new Date().getFullYear() %> Goan Craving</span><span>A taste of Goa, delivered with love.</span></footer>
</div>
<%- include("./partials/scripts") %>
</body>
</html>