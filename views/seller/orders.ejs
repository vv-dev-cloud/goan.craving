<!doctype html>
<html lang="en"><head><%- include("../partials/head") %><title>Seller Orders | Goan Craving</title>
<style>
:root{--green:#174b2b;--cream:#f7f8f3;--muted:#788078}body{background:var(--cream)}.shell{max-width:1200px;margin:92px auto 48px;padding:20px;color:#243329}.heading{display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap;margin-bottom:22px}.heading h1{color:var(--green);margin:0}.heading p{color:var(--muted)}a.btn{background:#ef7138;color:white;text-decoration:none;padding:12px 16px;border-radius:10px;font-weight:700}.panel{background:white;border:1px solid #e8ece4;border-radius:16px;overflow:auto}.table{width:100%;min-width:680px;border-collapse:collapse}.table th,.table td{text-align:left;padding:15px 18px;border-bottom:1px solid #eef0eb}.table th{font-size:.75rem;text-transform:uppercase;color:#788078;background:#fafbf8}.status{font-weight:700;color:var(--green)}.empty{padding:36px;text-align:center;color:var(--muted)}
</style></head><body><%- include("../partials/nave") %><main class="shell"><header class="heading"><div><h1>Your orders &amp; sales</h1><p>Only orders containing your listed food. Customer personal details are not shown.</p></div><a class="btn" href="/seller/dashboard">Back to dashboard</a></header><section class="panel"><% if(!orders.length){ %><div class="empty">No orders for your food products yet.</div><% }else{ %><table class="table"><thead><tr><th>Order reference</th><th>Items ordered</th><th>Qty</th><th>Your item total</th><th>Date</th><th>Status</th></tr></thead><tbody><% orders.forEach(order=>{ const qty=order.items.reduce((sum,item)=>sum+item.quantity,0); const amount=order.items.reduce((sum,item)=>sum+item.unitPrice*item.quantity,0); %><tr><td><%= String(order._id).slice(-8).toUpperCase() %></td><td><%= order.items.map(item=>item.name).join(", ") %></td><td><%= qty %></td><td>₹<%= amount.toFixed(2) %></td><td><%= new Date(order.createdAt).toLocaleDateString("en-IN") %></td><td class="status"><%= order.orderStatus.replaceAll("_"," ") %></td></tr><% }) %></tbody></table><% } %></section></main><%- include("../partials/scripts") %></body></html>