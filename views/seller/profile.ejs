<!doctype html>
<html lang="en"><head><%- include("../partials/head") %><title>Seller Profile | Goan Craving</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><style>
body{background:#f7f8f3;color:#243329}.profile-wrap{max-width:900px;margin:95px auto 50px;padding:18px}.profile-card{background:#fff;border:1px solid #e8ece3;border-radius:22px;padding:clamp(20px,4vw,36px);box-shadow:0 12px 35px #283b2210}.profile-card h1{color:#174b2b;margin:0}.profile-intro{color:#788078;line-height:1.6}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.profile-field label{display:block;font-weight:750;margin:0 0 7px}.profile-field input{box-sizing:border-box;width:100%;padding:13px;border:1px solid #e1e7dc;border-radius:11px;font:inherit}.profile-field{margin:9px 0}.profile-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.profile-btn{border:0;border-radius:11px;background:#ef7138;color:white;padding:13px 18px;font-weight:800;text-decoration:none;cursor:pointer}.profile-btn.secondary{background:#edf4e9;color:#174b2b}.profile-btn.remove{background:#fff1ec;color:#a5412a;border:1px solid #f2d3c8}.profile-notice{background:#e9f6e9;color:#216c36;padding:12px;border-radius:10px}.seller-map{height:300px;border:1px solid #e1e7dc;border-radius:12px;margin:12px 0}.profile-error{background:#fff0ed;color:#a32c1b;padding:12px;border-radius:10px}@media(max-width:620px){.profile-grid{grid-template-columns:1fr}}
</style></head><body><%- include("../partials/nave") %><main class="profile-wrap"><section class="profile-card">
<h1>Seller account profile</h1><p class="profile-intro">Manage your seller identity and restaurant details. These details help customers and delivery partners identify your kitchen.</p>
<% if(notice){ %><p class="profile-notice" role="status"><%= notice %></p><% } %><% if(error){ %><p class="profile-error" role="alert"><%= error %></p><% } %>
<form method="post" action="/seller/profile"><div class="profile-grid">
<div class="profile-field"><label for="fullName">Seller full name</label><input id="fullName" name="fullName" value="<%= user.sellerProfile.fullName || '' %>" required minlength="2" maxlength="100"></div>
<div class="profile-field"><label for="showName">Seller display name</label><input id="showName" name="showName" value="<%= user.sellerProfile.showName || '' %>" required minlength="2" maxlength="80"></div>
<div class="profile-field"><label for="restaurantName">Restaurant name</label><input id="restaurantName" name="restaurantName" value="<%= user.sellerProfile.restaurantName || '' %>" required minlength="2" maxlength="120"></div>
<div class="profile-field"><label for="city">City / town</label><input id="city" name="city" value="<%= user.sellerProfile.city || '' %>" required minlength="2" maxlength="100"></div>
<div class="profile-field" style="grid-column:1/-1"><label for="address">Exact address / landmark</label><input id="address" name="address" value="<%= user.sellerProfile.address || '' %>" required minlength="2" maxlength="240"></div>
</div><div id="seller-location-map" class="seller-map" data-key="<%= process.env.STADIA_MAPS_API_KEY || '' %>" data-lat="<%= user.sellerProfile.latitude || 15.2993 %>" data-lng="<%= user.sellerProfile.longitude || 74.1240 %>"></div><input type="hidden" id="latitude" name="latitude" value="<%= user.sellerProfile.latitude ?? '' %>"><input type="hidden" id="longitude" name="longitude" value="<%= user.sellerProfile.longitude ?? '' %>"><button type="button" id="seller-location-search" class="profile-btn secondary">Find address on map</button><div class="profile-actions"><button class="profile-btn" type="submit">Save profile changes</button><a class="profile-btn secondary" href="/seller/dashboard">Back to dashboard</a></div></form>
<hr style="border:0;border-top:1px solid #edf0e9;margin:28px 0"><section id="settings"><h2 style="color:#174b2b">Settings</h2><p class="profile-intro">Restaurant location settings. Removing the location returns the account to registration until a new location is entered.</p>
<form method="post" action="/seller/profile/remove-location" onsubmit="return confirm('Remove the restaurant location? You will need to enter it again to access the seller dashboard.')"><button class="profile-btn remove" type="submit">Remove restaurant location</button></form></section>
</section></main><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/sellerStadiaMap.js" defer></script><%- include("../partials/scripts") %></body></html>