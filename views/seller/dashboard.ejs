<!doctype html><html lang="en"><head><%- include("../partials/head") %><title>Seller Dashboard | Goan Craving</title>
<style>
.seller-page{max-width:1200px;margin:100px auto 60px;padding:20px}.seller-top{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.seller-top h1{color:#17552b;margin:0}.seller-action{background:#f36b35;color:#fff;text-decoration:none;padding:12px 17px;border-radius:12px;font-weight:800}.seller-products{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px;margin-top:25px}.seller-product{border:1px solid #eadfce;border-radius:18px;overflow:hidden;background:#fff}.seller-product img{width:100%;height:170px;object-fit:cover;background:#f7eee3}.seller-product-info{padding:15px}.seller-product-info h3{margin:0 0 6px}.seller-muted{color:#71685d;font-size:.9rem}.seller-delete{border:1px solid #e8c7bd;background:#fff7f4;color:#a33a23;padding:8px 11px;border-radius:9px;cursor:pointer}@media(max-width:600px){.seller-page{padding:12px}.seller-product img{height:200px}}
</style></head><body><%- include("../partials/nave") %><main class="seller-page">
<div class="seller-top"><div><p class="seller-muted">Seller workspace</p><h1>Welcome, <%= user.sellerProfile.showName %></h1><p class="seller-muted">Manage your food listings in one place.</p></div><a class="seller-action" href="/seller/products/new">＋ Add food</a></div>
<% if(!products.length){ %><section style="margin-top:25px;padding:35px;border:1px dashed #dfcfba;border-radius:18px;text-align:center"><h2>Your menu starts here</h2><p class="seller-muted">Add a food photo, description and price to publish your first item.</p><a class="seller-action" href="/seller/products/new">Add your first food</a></section><% }else{ %>
<div class="seller-products"><% products.forEach(product=>{ %><article class="seller-product"><img src="<%= product.imageURL || '/imgs/default.png' %>" alt="<%= product.name %>" loading="lazy" onerror="this.src='/imgs/default.png'"><div class="seller-product-info"><h3><%= product.name %></h3><p class="seller-muted"><%= product.category %> · ₹<%= Number(product.price).toFixed(2) %></p><p class="seller-muted"><%= product.isAvailable?'Available':'Unavailable' %></p><form method="post" action="/seller/products/<%= product._id %>/delete" onsubmit="return confirm('Delete this food listing?')"><button class="seller-delete" type="submit">Delete listing</button></form></div></article><% }) %></div><% } %>
</main><%- include("../partials/scripts") %></body></html>
