<!doctype html>
<html lang="en"><head><%- include("./partials/head") %><meta name="viewport" content="width=device-width,initial-scale=1"><title>Settings | Goan Craving</title>
<style>
:root{--green:#174d35;--green2:#286b4b;--orange:#e9783e;--cream:#fbf7ef;--line:#eee6da;--muted:#7c756b}
*{box-sizing:border-box}body{background:var(--cream);color:#27352b}.settings-page{max-width:980px;margin:0 auto;padding:70px 16px 70px}.hero{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}.hero h1{font-size:1.8rem;font-weight:900;color:var(--green);margin:0}.hero p{color:var(--muted);margin:6px 0 0}.back{color:var(--green);font-weight:800;text-decoration:none}.settings-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:20px}.nav,.panel{background:#fff;border:1px solid var(--line);border-radius:18px}.nav{padding:10px;height:max-content;position:sticky;top:18px}.nav button{display:flex;align-items:center;gap:10px;width:100%;border:0;background:transparent;text-align:left;padding:12px;border-radius:11px;color:#625b51;font-weight:800;cursor:pointer}.nav button.active,.nav button:hover{background:#eaf2eb;color:var(--green)}.panel{padding:22px}.section{display:none}.section.active{display:block}.section h2{color:var(--green);font-size:1.2rem;font-weight:900;margin:0}.intro{color:var(--muted);font-size:.86rem;margin:6px 0 18px}.setting-row{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:15px 0;border-bottom:1px solid var(--line)}.setting-row:last-child{border-bottom:0}.setting-row strong{display:block}.setting-row small{display:block;color:var(--muted);margin-top:4px;line-height:1.45}.switch{width:46px;height:26px;flex:none;position:relative}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;border-radius:99px;background:#c9c1b7;cursor:pointer;transition:.2s}.slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;border-radius:50%;background:#fff;transition:.2s}.switch input:checked+.slider{background:var(--green2)}.switch input:checked+.slider:before{transform:translateX(20px)}.theme-options{display:flex;gap:8px;flex-wrap:wrap}.theme-options button,.action-link,.save{border:1px solid var(--line);border-radius:10px;padding:10px 13px;background:#fff;color:#3c473e;font-weight:800;text-decoration:none;cursor:pointer}.theme-options button.active,.save{background:var(--green);border-color:var(--green);color:#fff}.action-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.action-link{display:flex;gap:10px;align-items:center;padding:15px}.action-link i{color:var(--green)}.password-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.password-fields label{font-size:.8rem;font-weight:800}.password-fields input{display:block;width:100%;margin-top:6px;padding:11px;border:1px solid var(--line);border-radius:10px}.status{min-height:20px;color:var(--green);font-size:.84rem;margin-top:12px}.mobile-tabs{display:none;width:100%;padding:11px;border:1px solid var(--line);border-radius:11px;background:#fff;margin-bottom:12px}
@media(max-width:700px){.settings-page{padding:70px 12px 55px}.settings-grid{grid-template-columns:1fr}.nav{display:none}.mobile-tabs{display:block}.hero{align-items:flex-start}.hero h1{font-size:1.5rem}.panel{padding:17px}.action-links{grid-template-columns:1fr}.password-fields{grid-template-columns:1fr}}
</style></head><body><%- include("./partials/nave") %>
<main class="settings-page"><header class="hero"><div><h1><i class="fa-solid fa-sliders"></i> Account settings</h1><p>Manage your Goan Craving delivery experience.</p></div><a class="back" href="/account"><i class="fa-solid fa-arrow-left"></i> My account</a></header>
<select class="mobile-tabs" id="mobileTabs" aria-label="Settings section"><option value="preferences">Preferences</option><option value="notifications">Notifications</option><option value="privacy">Privacy</option><option value="security">Security</option><option value="shortcuts">Quick links</option></select>
<div class="settings-grid"><nav class="nav" aria-label="Settings navigation"><button class="active" data-tab="preferences"><i class="fa-solid fa-sliders"></i> Preferences</button><button data-tab="notifications"><i class="fa-regular fa-bell"></i> Notifications</button><button data-tab="privacy"><i class="fa-solid fa-shield-halved"></i> Privacy</button><button data-tab="security"><i class="fa-solid fa-lock"></i> Security</button><button data-tab="shortcuts"><i class="fa-solid fa-link"></i> Quick links</button></nav>
<div class="panel">
<section class="section active" id="preferences"><h2>Delivery preferences</h2><p class="intro">Choose how Goan Craving looks and how you prefer to receive updates.</p><div class="setting-row"><div><strong>Appearance</strong><small>Choose the display theme for your account.</small></div><div class="theme-options"><button type="button" data-theme="light">Light</button><button type="button" data-theme="dark">Dark</button><button type="button" data-theme="system">System</button></div></div><div class="setting-row"><div><strong>Default delivery area</strong><small><%= user.location || 'Not set' %> · Edit this in your profile.</small></div><a class="action-link" href="/user/profile/edit">Edit</a></div><div class="setting-row"><div><strong>Saved delivery addresses</strong><small>Manage home, work and other delivery locations.</small></div><a class="action-link" href="/account#addresses">Manage</a></div><div class="setting-row"><div><strong>Payment methods</strong><small>Review available saved payment methods.</small></div><a class="action-link" href="/account#payments">Manage</a></div></section>
<section class="section" id="notifications"><h2>Notifications</h2><p class="intro">Choose which account alerts you receive. Order status is always available in My Orders.</p><% const ns=user.notificationSettings||{}; %><div class="setting-row"><div><strong>Push notifications</strong><small>Allow browser or device notifications where supported.</small></div><label class="switch"><input class="notification" data-key="pushEnabled" type="checkbox" <%= ns.pushEnabled?'checked':'' %>><span class="slider"></span></label></div><div class="setting-row"><div><strong>Message notifications</strong><small>Alerts about customer-support conversations.</small></div><label class="switch"><input class="notification" data-key="pushOnMessage" type="checkbox" <%= ns.pushOnMessage!==false?'checked':'' %>><span class="slider"></span></label></div><div class="setting-row"><div><strong>Email updates</strong><small>Receive important account emails.</small></div><label class="switch"><input class="notification" data-key="emailDigest" type="checkbox" <%= ns.emailDigest!==false?'checked':'' %>><span class="slider"></span></label></div><div class="setting-row"><div><strong>Comment email alerts</strong><small>Legacy community activity notifications, optional.</small></div><label class="switch"><input class="notification" data-key="emailOnComment" type="checkbox" <%= ns.emailOnComment!==false?'checked':'' %>><span class="slider"></span></label></div></section>
<section class="section" id="privacy"><h2>Privacy</h2><p class="intro">Control the visibility of your account and keep your information safe.</p><div class="setting-row"><div><strong>Private account</strong><small>Restrict visibility of your community profile. This does not affect your food orders.</small></div><label class="switch"><input id="privateToggle" type="checkbox" <%= user.isPrivate?'checked':'' %>><span class="slider"></span></label></div><div class="setting-row"><div><strong>Personal information</strong><small>Your saved addresses and refund details are only available in your signed-in account.</small></div><a class="action-link" href="/account">Review account</a></div></section>
<section class="section" id="security"><h2>Account security</h2><p class="intro">Protect access to your Goan Craving account.</p><div class="setting-row"><div><strong>Sign-in email</strong><small><%= user.email %></small></div></div><div class="password-fields"><label>Current password<input id="currentPassword" type="password" autocomplete="current-password"></label><label>New password<input id="newPassword" type="password" minlength="8" autocomplete="new-password"></label></div><p class="intro">Google-only accounts cannot change a local password here. Use your Google account security settings instead.</p><button id="changePassword" class="save" type="button">Update password</button><div class="setting-row"><div><strong>Password reset</strong><small>Use the secure email reset flow if you cannot sign in.</small></div><a class="action-link" href="/user/signin#forgot-password">Reset</a></div></section>
<section class="section" id="shortcuts"><h2>Quick links</h2><p class="intro">Common customer account tasks.</p><div class="action-links"><a class="action-link" href="/orders"><i class="fa-solid fa-bag-shopping"></i> My orders</a><a class="action-link" href="/account#addresses"><i class="fa-solid fa-location-dot"></i> Delivery addresses</a><a class="action-link" href="/account#payments"><i class="fa-regular fa-credit-card"></i> Payment methods</a><a class="action-link" href="/support/chat"><i class="fa-solid fa-headset"></i> Help & support</a></div></section>
<div class="status" id="status" role="status" aria-live="polite"></div>
</div></div></main>
<%- include("./partials/scripts") %><script>
const statusEl=document.getElementById('status');function status(m){statusEl.textContent=m}async function patch(url,body){const r=await fetch(url,{method:'PATCH',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to save setting');return d}
function activate(id){document.querySelectorAll('.section').forEach(s=>s.classList.toggle('active',s.id===id));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));document.getElementById('mobileTabs').value=id}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>activate(b.dataset.tab)));document.getElementById('mobileTabs').addEventListener('change',e=>activate(e.target.value));
document.querySelectorAll('[data-theme]').forEach(b=>{b.classList.toggle('active',b.dataset.theme==='<%= user.theme || "system" %>');b.addEventListener('click',async()=>{try{await patch('/user/profile/settings/theme',{theme:b.dataset.theme});document.querySelectorAll('[data-theme]').forEach(x=>x.classList.toggle('active',x===b));status('Appearance preference saved.')}catch(e){status(e.message)}})});
document.querySelectorAll('.notification').forEach(input=>input.addEventListener('change',async()=>{try{await patch('/user/profile/settings/notifications',{[input.dataset.key]:input.checked});status('Notification preference saved.')}catch(e){input.checked=!input.checked;status(e.message)}}));
document.getElementById('privateToggle').addEventListener('change',async e=>{const value=e.target.checked;try{await patch('/user/profile/settings/privacy',{isPrivate:value});status('Privacy preference saved.')}catch(err){e.target.checked=!value;status(err.message)}});
document.getElementById('changePassword').addEventListener('click',async()=>{const currentPassword=document.getElementById('currentPassword').value,newPassword=document.getElementById('newPassword').value;if(!currentPassword||newPassword.length<8){status('Enter your current password and a new password of at least 8 characters.');return}try{const r=await fetch('/user/change-password',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({currentPassword,newPassword})});const d=await r.json();if(!r.ok||!d.success)throw new Error(d.message||'Unable to change password');status('Password changed. Please sign in again.');setTimeout(()=>location.href='/user/logout',900)}catch(e){status(e.message)}});
</script></body></html>