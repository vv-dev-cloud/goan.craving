<!DOCTYPE html>
<html lang="en">
<head>
<%- include("./partials/head") %>
<meta name="description" content="Discover delicious Goan food, local favourites and fresh cravings on Goan Craving.">
<title>Goan Craving — Discover food</title>
<style>
:root{--gc-ink:#27231f;--gc-muted:#7c736a;--gc-line:#eee4d8;--gc-cream:#fff8ef;--gc-orange:#f36b35;--gc-green:#286b4b}
body{background:#fff;color:var(--gc-ink)}.gc-home{max-width:1280px;margin:auto;padding:24px 28px 70px}.gc-welcome{border-radius:32px;background:radial-gradient(circle at 85% 12%,#f7dfc7 0,transparent 34%),linear-gradient(125deg,#fff8ef,#fff2e4);padding:clamp(30px,5vw,66px);display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center;overflow:hidden;box-shadow:var(--gc-shadow)}.gc-kicker{font-size:.74rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase;color:var(--gc-green)}.gc-welcome h1{font-size:clamp(2.6rem,6vw,5rem);line-height:.98;letter-spacing:-.075em;margin:16px 0}.gc-welcome h1 em{font-style:normal;color:var(--gc-orange)}.gc-welcome p{max-width:520px;color:var(--gc-muted);line-height:1.7;font-size:1.02rem}.gc-hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.gc-hero-actions a{display:inline-block;padding:13px 20px;border-radius:999px;text-decoration:none;font-weight:800}.gc-cta{background:var(--gc-orange);color:#fff}.gc-hero-img{width:100%;height:370px;object-fit:cover;border-radius:28px;box-shadow:0 25px 65px #5a351b2b;transform:rotate(1.2deg)}.gc-top-search{display:flex;gap:12px;align-items:center;margin:0 0 22px}.gc-top-search .gc-search{flex:1;margin:0}.gc-cart-link{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;padding:13px 18px;border-radius:999px;background:#286b4b;color:#fff;text-decoration:none;font-weight:850}.gc-search{display:flex;gap:10px;margin:28px 0 34px;padding:9px;border:1px solid var(--gc-line);border-radius:18px;background:#fff;box-shadow:0 12px 36px rgba(70,42,18,.06)}.gc-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;padding:9px 12px;font:inherit}.gc-search select{border:1px solid var(--gc-line);border-radius:10px;background:white;color:var(--gc-ink);padding:0 10px}.gc-search button{border:0;border-radius:999px;background:var(--gc-green);color:white;padding:10px 18px;font-weight:800}.gc-cats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0 45px}.gc-cat{border:1px solid var(--gc-line);border-radius:22px;padding:20px;background:white;box-shadow:0 8px 28px rgba(70,42,18,.035);transition:transform .2s,box-shadow .2s}.gc-cat:hover{transform:translateY(-4px);box-shadow:var(--gc-shadow)}.gc-cat span{font-size:1.5rem}.gc-cat h3{font-size:.98rem;margin:10px 0 5px}.gc-cat p{font-size:.8rem;color:var(--gc-muted);margin:0;line-height:1.5}.gc-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:12px}.gc-heading h2{font-size:clamp(1.7rem,3.5vw,2.5rem);letter-spacing:-.06em;margin:0}.gc-heading p{margin:7px 0 0;color:var(--gc-muted)}.gc-discover{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:26px}.gc-feed{min-width:0}.gc-dish{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:18px;padding:20px 0;border-top:1px solid var(--gc-line)}.gc-dish-img{width:100%;height:160px;object-fit:cover;border-radius:18px;background:#f4eee6}.gc-dish h3{font-size:1.18rem;line-height:1.25;margin:8px 0}.gc-dish h3 a{color:inherit;text-decoration:none}.gc-dish p{color:var(--gc-muted);font-size:.88rem;line-height:1.55;margin:0 0 12px}.gc-meta{font-size:.77rem;color:var(--gc-muted);display:flex;gap:8px;align-items:center}.gc-badge{display:inline-block;padding:5px 9px;background:#f4efe7;color:var(--gc-green);border-radius:999px;font-size:.7rem;font-weight:800}.gc-side{height:max-content;position:sticky;top:20px}.gc-side-card{padding:20px;border:1px solid var(--gc-line);border-radius:18px;margin-bottom:14px}.gc-side-card h3{margin:0 0 8px}.gc-side-card p{font-size:.86rem;color:var(--gc-muted);line-height:1.6}.gc-side-card a{display:inline-block;text-decoration:none;color:var(--gc-green);font-weight:800}.gc-topics a{background:#f8f2e9;border-radius:999px;padding:7px 10px;font-size:.78rem;margin:0 5px 7px 0}.gc-empty{text-align:center;padding:42px 20px;border:1px dashed var(--gc-line);border-radius:18px;color:var(--gc-muted)}.gc-footer{margin-top:50px;border-top:1px solid var(--gc-line);padding-top:20px;color:#93877b;font-size:.78rem;display:flex;justify-content:space-between;gap:15px}
@media(max-width:850px){.gc-welcome{grid-template-columns:1fr}.gc-hero-img{height:280px}.gc-discover{grid-template-columns:1fr}.gc-side{position:static;display:grid;grid-template-columns:1fr 1fr;gap:12px}.gc-cats{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.gc-top-search{align-items:stretch;flex-direction:column}.gc-top-search .gc-search{flex-wrap:nowrap}.gc-top-search .gc-search input{flex-basis:0}.gc-cart-link{width:100%}.gc-home{padding:14px 14px 50px}.gc-welcome{padding:25px 20px}.gc-hero-img{height:220px}.gc-search{flex-wrap:wrap}.gc-search input{flex-basis:100%}.gc-search select{height:40px;flex:1}.gc-dish{grid-template-columns:1fr}.gc-dish-img{height:210px;order:-1}.gc-side{display:block}.gc-footer{flex-wrap:wrap}}

/* Fresh tropical Goan Craving visual refresh */
body{background:#fff7e8!important;color:#192318}
.gc-home{max-width:1440px;padding:0 0 55px}
.gc-welcome{border-radius:0;min-height:410px;grid-template-columns:1fr;background:linear-gradient(90deg,rgba(255,231,178,.96),rgba(255,225,165,.78) 45%,rgba(255,225,165,.04)),url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1800&q=85');background-size:cover;background-position:center;padding:clamp(28px,5vw,70px);box-shadow:none}
.gc-welcome h1{font-family:Georgia,serif;font-size:clamp(3rem,7vw,6.2rem);color:#0a4516;letter-spacing:-.06em}
.gc-welcome h1 em{color:#0b4d18}
.gc-kicker{font-family:Georgia,serif;font-style:italic;text-transform:none;letter-spacing:0;color:#63350e;font-size:1.25rem}
.gc-welcome p{color:#4d3217;font-weight:600}
.gc-hero-img{display:none}
.gc-hero-actions .gc-cta{background:#ff5a08;box-shadow:0 8px 20px #e84b1230}
.gc-search{border-radius:999px;padding:6px;background:#fff;box-shadow:0 8px 24px #6c3b1720}
.gc-search button{border-radius:999px;padding:12px 24px}
.gc-cats{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.gc-cat{border-radius:18px;background:#fffaf0;box-shadow:0 5px 14px #4b2b111b;transition:transform .2s,box-shadow .2s}
.gc-cat:hover{transform:translateY(-4px);box-shadow:0 12px 25px #4b2b1124}
.gc-heading h2{color:#0a4516;font-weight:900}
.gc-heading p{color:#565b4d}
.gc-dish-img{border-radius:17px}
.gc-side-card{background:#fffaf0}
.gc-how{padding:30px 28px 10px}
.gc-how-title{text-align:center;color:#0a4516;font-size:clamp(1.7rem,3vw,2.4rem);font-weight:900;margin:0 0 5px}
.gc-how-sub{text-align:center;margin:0;color:#565b4d}
.gc-how-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;margin:25px 0}
.gc-how-icon{width:68px;height:68px;border-radius:50%;background:#e7f2b9;display:grid;place-items:center;margin:0 auto 10px;font-size:2rem;color:#145b20}
.gc-how-steps h3{font-size:1rem;margin:0 0 5px}.gc-how-steps p{font-size:.88rem;color:#666;margin:0}
@media(max-width:850px){.gc-welcome{min-height:350px;background-position:60% center}.gc-cats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.gc-welcome{padding:28px 20px;min-height:400px}.gc-how-steps{grid-template-columns:repeat(2,1fr)}}

</style>
</head>
<body>
<%- include("./partials/nave") %>
<main class="gc-home">
<div class="gc-top-search">
<form class="gc-search" action="/search" method="GET"><input name="q" placeholder="Search food like Chicken Cafreal or Fish Curry..." aria-label="Search food" required><button type="submit">Search food</button></form>
<a class="gc-cart-link" href="/cart" aria-label="Open cart">🛒 Cart</a>
</div>
<section class="gc-welcome">
<div><div class="gc-kicker">Welcome back · Goan Craving</div><h1>What are you<br><em>craving today?</em></h1><p>Discover local favourites, coastal flavours and delicious finds. Explore the food stories and inspiration shared with the Goan Craving community.</p><div class="gc-hero-actions"><a class="gc-cta" href="#discover">Explore food picks ↓</a><a href="/post" class="btn btn-outline-success rounded-pill fw-bold">Share a food moment</a></div></div>
<img class="gc-hero-img" src="https://images.unsplash.com/photo-1565557623262-b51c2513a641?auto=format&fit=crop&w=1000&q=85" alt="A colourful meal with rich curry and rice" loading="eager">
</section>
<section aria-label="Food categories"><div class="gc-heading" style="margin-top:36px"><div><h2>Explore your cravings</h2><p>A little something for every appetite.</p></div></div><div class="gc-cats">
<div class="gc-cat"><span>🍛</span><h3>Goan classics</h3><p>Comforting local flavours</p></div><div class="gc-cat"><span>🐟</span><h3>Coastal favourites</h3><p>Fresh and full of flavour</p></div><div class="gc-cat"><span>🥘</span><h3>Hearty meals</h3><p>Good food, generous plates</p></div><div class="gc-cat"><span>🍰</span><h3>Sweet cravings</h3><p>A treat for later</p></div>
</div></section>
<section class="gc-how" id="how-it-works"><h2 class="gc-how-title">🌴 How it Works</h2><p class="gc-how-sub">Get your favourite Goan food in just a few clicks!</p><div class="gc-how-steps"><div><div class="gc-how-icon">⌕</div><h3>1. Search</h3><p>Find your favourite dish</p></div><div><div class="gc-how-icon">🛒</div><h3>2. Add to Cart</h3><p>Choose and add items</p></div><div><div class="gc-how-icon">🛵</div><h3>3. Place Order</h3><p>Checkout and order</p></div><div><div class="gc-how-icon">☺</div><h3>4. Enjoy!</h3><p>Food at your doorstep</p></div></div></section>
<section id="discover">
<div class="gc-heading"><div><h2><%=search?'Your search':'Food inspiration'%></h2><p><%=search?'Here are the matching community posts.':'Ideas and posts from the Goan Craving community.'%></p></div></div>
<div class="gc-discover"><div class="gc-feed">

<% if(!blogs||!blogs.length){ %><div class="gc-empty"><h3>No food posts found yet</h3><p>Try a different search, or share the first food moment.</p><% if(locals.user){ %><a href="/post">Share a post →</a><% } %></div><% }else{ blogs.forEach(blog=>{ const mediaType=String(blog.mediaType||'').toLowerCase()||(blog.videoURL?'video':((blog.coverImageURL||blog.coverImage||blog.imageURL||blog.imageUrl||blog.image?.secure_url||blog.media?.secure_url)?'photo':'blog')); const videoCandidate=blog.videoURL||blog.video?.secure_url||blog.media?.secure_url||''; const videoUrl=typeof videoCandidate==='string'?videoCandidate.trim():''; const imageCandidates=[blog.coverImageURL,blog.coverImage,blog.imageURL,blog.imageUrl,blog.image?.secure_url,blog.image?.url,blog.media?.secure_url,blog.media?.url,blog.thumbnailURL,blog.thumbnailUrl]; const rawImageUrl=imageCandidates.find(value=>typeof value==='string'&&value.trim())||''; const imageUrl=typeof rawImageUrl==='string'?rawImageUrl.trim():''; %>
<article class="gc-dish"><div><span class="gc-badge"><%=mediaType==='video'?'Food video':mediaType==='photo'?'Food photo':'Community story'%></span><h3><a href="/blogs/<%=blog._id%>"><%=truncate(blog.title,80)%></a></h3><p><%=truncate(blog.excerpt||(blog.body?blog.body.substring(0,170):''),150)%></p><div class="gc-meta"><span><%=blog.createdBy?.fullName||'Goan Craving community'%></span><span>·</span><span><%=blog.viewCount||0%> views</span></div></div><div>
<% if(mediaType==='video'&&videoUrl){ %><video class="gc-dish-img" controls playsinline preload="metadata" src="<%=videoUrl%>" poster="<%=imageUrl||'/imgs/default.png'%>"></video><% }else if(imageUrl){ %><img class="gc-dish-img" src="<%=imageUrl%>" alt="<%=blog.title%>" loading="lazy" onerror="this.onerror=null;this.src='/imgs/default.png'"><% }else{ %><img class="gc-dish-img" src="/imgs/default.png" alt="Food post image unavailable" loading="lazy"><% } %></div></article>
<% }) } %>
</div><aside class="gc-side"><div class="gc-side-card"><h3>Share a delicious moment</h3><p>Post a food photo, video, or story for the community.</p><% if(locals.user){ %><a href="/post">Create a food post ↗</a><% } %></div><div class="gc-side-card gc-topics"><h3>Browse inspiration</h3><p>Explore topics from the community.</p><a href="/blogs/tags/lifestyle">Local life</a><a href="/blogs/tags/travel">Travel</a><a href="/blogs/tags/food">Food</a><a href="/blogs/tags/cooking">Cooking</a></div></aside></div>
</section>
<footer class="gc-footer"><span>© <%= new Date().getFullYear() %> Goan Craving</span><span>Goan flavour, community inspiration.</span></footer>
</main>
<%- include("./partials/scripts") %>
</body>
</html>